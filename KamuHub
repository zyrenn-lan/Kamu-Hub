local function Toggle(page, key, default, cb)
    local r = row(page)
    rowLabel(r, key)
    local sw = new("Frame", { Size = UDim2.fromOffset(40, 20), Position = UDim2.new(1, -52, 0.5, -10), BorderSizePixel = 0 }, r)
    corner(sw, 10)
    local knob = new("Frame", { Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, sw)
    corner(knob, 8)
    local state = default
    local function render()
        sw.BackgroundColor3 = state and theme.Accent or theme.Off
        TS:Create(knob, TweenInfo.new(0.15), { Position = state and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2) }):Play()
    end
    onAccent(render)
    local btn = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "" }, r)
    btn.MouseButton1Click:Connect(function()
        local new_ = not state
        local ok = cb(new_)
        if ok == false then return end
        state = new_
        render()
    end)
    return r
end

local function Slider(page, key, min, max, def, cb)
    local r = row(page, 52)
    rowLabel(r, key, -80)
    local val = new("TextLabel", {
        Size = UDim2.fromOffset(60, 28), Position = UDim2.new(1, -68, 0, 0), BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = theme.Sub, Text = tostring(def),
        TextXAlignment = Enum.TextXAlignment.Right,
    }, r)
    local bar = new("Frame", { Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 12, 1, -14), BackgroundColor3 = theme.Off, BorderSizePixel = 0 }, r)
    corner(bar, 3)
    local fill = new("Frame", { Size = UDim2.fromScale((def - min) / (max - min), 1), BorderSizePixel = 0 }, bar)
    corner(fill, 3)
    onAccent(function() fill.BackgroundColor3 = theme.Accent end)
    local dragging = false
    local function upd(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + (max - min) * rel + 0.5)
        fill.Size = UDim2.fromScale(rel, 1)
        val.Text = tostring(v)
        cb(v)
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; upd(i.Position.X)
        end
    end)
    bind(UIS.InputChanged, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end
    end)
    bind(UIS.InputEnded, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

