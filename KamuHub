local function selectTab(t)
    currentTab = t
    for _, x in ipairs(tabs) do
        local on = (x == t)
        x.page.Visible = on
        x.btn.BackgroundColor3 = on and theme.Accent or theme.Card
        x.btn.BackgroundTransparency = on and 0.1 or 0.4
    end
    pageTitle.Text = tr(t.key)
end
onAccent(function() if currentTab then selectTab(currentTab) end end)
onLang(function() if currentTab then pageTitle.Text = tr(currentTab.key) end end)

